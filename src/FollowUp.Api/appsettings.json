{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "FollowUp": ""
  },
  "Auth": {
    "SigningSecret": "",
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 15,
    "TokenLifetimeHours": 10
  },
  "AllowedOrigins": [ "http://localhost:4200" ],
  "AllowedHosts": "*"
}
