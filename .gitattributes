# Normalize line endings — repo canonical is LF; checkout native.
* text=auto

*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sln       text eol=crlf
*.html      text eol=lf
*.ts        text eol=lf
*.html      text eol=lf

# Binary assets
*.png       binary
*.docx      binary
*.jpg       binary
*.ico       binary
